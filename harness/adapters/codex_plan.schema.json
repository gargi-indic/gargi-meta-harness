{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "summary": { "type": "string" },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "files": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" }
        },
        "required": ["title", "files", "notes"]
      }
    },
    "risks": { "type": "array", "items": { "type": "string" } },
    "questions": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["summary", "steps", "risks", "questions"]
}
